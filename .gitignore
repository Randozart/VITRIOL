# VITRIOL - .gitignore

# Build artifacts
*.o
*.ko
*.ko.cmd
*.mod
*.mod.o
*.mod.cmd
*.symvers
*.symvers.cmd
modules.order
modules.order.cmd
.*.cmd
*.a
*.so
*.so.*
build/
.tmp/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
dist/
eggs/

# Rust
/target/
**/target/
*.rs.bk
Cargo.lock

# Brief compiler output
out_test/
*_generated.c
*_generated.h

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
logs/

# Temporary files
/tmp/
*.tmp
*.temp

# Test outputs
test_results/
coverage/

# Swap files (large system files)
/swapfile
/swapfile2
/swapfile3

# Model files (too large for git)
*.gguf
*.bin
*.pt
*.pth
models/

# Alka compiler build artifacts (generated from .alka recipes)
*.alkas
*.azoth

# Benchmark results
alka/results/

# OS files
Thumbs.db
.DS_Store
alka-executor/alka-executor
alka-executor/gguf-offset-resolver
alka/generated/
*.alkas
*.azoth
vitriol-daemon/*.ko
vitriol-daemon/*.o
vitriol-daemon/*.mod*
vitriol-daemon/modules.order
vitriol-daemon/Module.symvers

# Test binaries (compiled from test_*.c/.cu)
vitriol_readback
test_p2p_dma
test_p2p_caps
test_p2p_attrs
test_mem_create
test_ioctl
scripts/gen_test_stream
vitriol-daemon/vitriol.mod.c
alka-executor/vitriol_ce_test
.aider*
