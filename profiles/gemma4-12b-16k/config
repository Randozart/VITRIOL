# VITRIOL Configuration — Gemma 4 12B IT Q4_K_M voice fast-lane (single RTX 3060, 16K)
# Kotoba Voice default: Japanese MT-Bench 0.806 (Swallow), ~25 tok/s class.
# 16K context keeps the KV cache small for real-time voice turns.

[gpu]
device = 0
exclude_secondary = true

[model]
path = /scratch/models/gemma-4-12b-it-Q4_K_M.gguf
context = 16384
threads = 4
ngl = 99
alias = Kotoba Gemma
expert_count = 0

[vitriol]
mode = off
lru_mb = 0
verbose = false
output_cache = off
predictive_prefetch = off
pin_first_n_layers = 0
prune_experts = 0
reasoning = off

[server]
cache_ram = 1024
host = 127.0.0.1
port = 8279
parallel = 1
chat_template =

[memory]
mode = off
semantic_mode = off

[kv]
quant_mode = q8_0
quant_mode_v = q8_0
ubatch_size = 64
