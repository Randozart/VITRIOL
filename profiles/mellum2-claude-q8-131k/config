# VITRIOL Configuration — Mellum2-Claude Thinking Q8_0 (dual-GPU, 131K)
# Claude Opus reasoning distill — "thinks before acting" to fix agentic initiative.
# reasoning MUST be on (NOT off; off is the Instruct fix and neuters thinking).
# [vitriol] mode = off (the 5-t/s culprit fix; restores native fast decode).
# ts 24,12, ctx 131072, ngl 99, flash-attn on.

[gpu]
device = 0
exclude_secondary = false
tensor_split = 24,12

[model]
path = /home/randozart/Downloads/mellum2-claude-Q8_0.gguf
context = 131072
threads = 4
ngl = 99
expert_count = 0

[vitriol]
mode = off
lru_mb = 0
verbose = false
output_cache = off
predictive_prefetch = off
pin_first_n_layers = 0
prune_experts = 0
reasoning = on

[server]
host = 127.0.0.1
port = 8279
parallel = 1

[memory]
mode = off
semantic_mode = off

[kv]
mode = standard
quant_mode = f16
quant_mode_v = f16
frozen_prompt = off

[engine]
mode = vitriol-dma

[lookup]
tokens = 0

[spec]
type =
draft_n_max = 0

[chimera]
mode = auto
