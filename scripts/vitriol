# llama-server must APPEND the inherited value (`...${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}`),
# never clobber it — the CUDA 12 runtime libs resolve from ~/.cuda-libs here, and an
# absolute assignment killed serve with "libcudart.so.12: cannot open shared object file".
# To undo: revert scripts/vitriol to the pre-append form in commit preceding a2218c6-era.
HEADER_FILE="${PROJECT_DIR}/assets/vitriol-header.txt"
