                read -r -p "Enter tokens: " val
                if [[ "$val" =~ ^[0-9]+$ ]] && ((val >= 0 && val <= 128)); then
                    config_set lookup_tokens "$val"
                else
                    echo "Invalid (must be 0-128)"; sleep 1
                fi
                ;;
            b|B) return ;;
            q|Q) clear; exit 0 ;;
        esac
    done
}

# ═════════════════════════════════════════════════════════════════
# RUN & SERVE
# ═════════════════════════════════════════════════════════════════

setup_caps() {
    local bin="${1:-$BINARY}"
    echo "→ Setting CAP_IPC_LOCK on $bin"
    if ! command -v sudo &>/dev/null; then
        echo "  ERROR: sudo not found"
        exit 1
    fi
    sudo setcap cap_ipc_lock=+ep "$bin"
    echo "  ✓ Done"
    getcap "$bin"
    echo ""
    echo "System RAM for page-locking: $(free -g | awk '/^Mem:/{print $2}') GiB total"
    echo "                             $(free -g | awk '/^Mem:/{print int($2*0.8)}') GiB available without swap pressure"
}

fix_rpath() {
    local dir="${1}"
    if [[ ! -d "$dir" ]]; then
        return
    fi
    echo "→ Fixing RUNPATH in $dir (replacing \$ORIGIN with absolute path)"
    local count=0
    for f in "$dir"/llama-server "$dir"/llama-cli "$dir"/llama-bench "$dir"/lib*.so*; do
        [[ -f "$f" ]] || continue
        if patchelf --set-rpath "$dir" "$f" 2>/dev/null; then
            count=$((count + 1))
        fi
    done
    echo "  ✓ Fixed $count ELF files"
    echo ""
}

usage() {
    print_header
    cat <<'HEREDOC'
  vitriol run [options]      interactive inference session
  vitriol serve [options]    persistent HTTP API server
  vitriol stop               stop running server
  vitriol bench [options]    quick throughput benchmark (uses llama-bench)
  vitriol tui                live dashboard (requires textual Python lib)
  vitriol config             interactive configuration TUI
  vitriol config show        print current configuration
  vitriol config init        create config file with defaults
  vitriol config reset       restore defaults
  vitriol config edit        open config in $EDITOR
  vitriol config set <key> <val>  set a config value
  vitriol calibrate [--quick] [--model <path>]  auto-tune config for this hardware+model
  vitriol setup              set CAP_IPC_LOCK capability
  vitriol tui                terminal ops dashboard (Ratatui, auto-builds first run)
  vitriol install [--prefix DIR] [--no-build]  symlink vitriol onto your PATH
  vitriol uninstall          remove the install-script symlinks
  vitriol pymander list     list Pymander reference-mind domains
  vitriol pymander ingest <domain> <file.md|->  ingest corpus as atomic nodes
  vitriol pymander nodes <domain>   show a domain's current nodes
  vitriol pymander search <domain> <query>  retrieve nodes for a query
  vitriol pymander select <project_id> <domain...>  set active domains for a project
  vitriol pymander active <project_id>  show a project's active domains
  vitriol officina [args]    the VITRIOL coding workshop: full-screen agent
                             harness in the current directory (local-inference
                             tuned; engine telemetry in the editor). Args pass
                             through to the scaffold CLI (e.g. -p "one-shot").
  vitriol officina [args]    the VITRIOL coding workshop: full-screen agent
                             harness in the current directory (local-inference
                             tuned; engine telemetry in the editor). Args pass
                             through to the scaffold CLI (e.g. -p "one-shot").
  vitriol validate           harness config gate (ex-tris)
  vitriol lanes              GPU lane report (ex-tris)
  vitriol budget             allocation vs measured ledger (ex-tris)
  vitriol ledger-ingest <f>  append a consumer usage report (ex-tris)
  vitriol perms-sync         mirror safety.permissions (ex-tris)
  vitriol status             validate + live engine probe (ex-tris)
  vitriol help               this message

Run options:
  -m PATH            model file path
  -c N               context window (tokens)
  -t N               CPU threads
  -ngl N             GPU layers to offload
  -lru MB            LRU VRAM cache size
  --memory-mode MODE   emulated memory: on | off
  --kv-mode MODE       KV cache: standard | offload | sparse
  --frozen-prompt M    frozen prompt caching: on | off
  --semantic-mode M    semantic search: on | off (requires sentence-transformers)
  --predictive-prefetch on|off  cross-layer expert prefetch (DMA stream overlap)
  --pin-layers N       pin first N layers' expert tensors in VRAM
  --prune-experts N    drop bottom N of 8 active experts (0-7, experimental)
  --verbose            enable debug logging
  --dry-run            print config without launching

Serve options:
  -m PATH            model file path
  -c N               context window (tokens)
  -t N               CPU threads
  -ngl N             GPU layers to offload
  -lru MB            LRU VRAM cache size
  --host ADDR        bind address (default: $DEFAULT_HOST)
  -port N            server port (default: $DEFAULT_PORT)
  -p N               parallel slots (default: $DEFAULT_PARALLEL)
  --memory-mode MODE   emulated memory: on | off
  --kv-mode MODE       KV cache: standard | offload | sparse
  --frozen-prompt M    frozen prompt caching: on | off
  --semantic-mode M    semantic search: on | off (requires sentence-transformers)
  --detach             run server in background
  --spec-type TYPE     speculative decoding type (mtp, draft, etc.)
  --spec-draft-n-max N number of tokens to draft (e.g. 2 for MTP)
  --spec-draft-model F separate draft model GGUF (e.g. MTP head)
  --spec-draft-device D device index for draft model (e.g. 1 = second GPU)
  --spec-draft-ngl N   draft model GPU layers (all | auto | N)
  --pin-layers N       pin first N layers' expert tensors in VRAM
  --prune-experts N    drop bottom N of 8 active experts (0-7, experimental)
  --verbose          enable debug logging
  --dry-run          print config without launching

All options can be persisted via: vitriol config

HEREDOC
}

# ═════════════════════════════════════════════════════════════════
# CALIBRATION
# ═════════════════════════════════════════════════════════════════

CALIBRATION_SCRIPT="${SCRIPT_DIR}/../libvitriol/gguf_reader.py"
CALIBRATE_BINARY="${PROJECT_DIR}/libvitriol/target/release/vitriol-calibrate"

# Try Rust binary first, fall back to Python
calibrate_use_rust() {
    if [[ -x "$CALIBRATE_BINARY" ]]; then
        return 0
    fi
    # Try debug build
    CALIBRATE_BINARY="${PROJECT_DIR}/libvitriol/target/debug/vitriol-calibrate"
    [[ -x "$CALIBRATE_BINARY" ]]
}

calibrate_probe_hardware() {
    local out="$CALIBRATION_DIR/hardware.json"
    mkdir -p "$CALIBRATION_DIR"

    local gpu_count=0
    local gpu_name=""
    local vram_total=0
    local compute_cap=""
    local pcie_gen=""
    local pcie_width=""

    if command -v nvidia-smi &>/dev/null; then
        gpu_count=$(nvidia-smi --query-gpu=count --format=csv,noheader 2>/dev/null | head -1 | tr -d ' ')
        gpu_name=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | head -1)
        vram_total=$(nvidia-smi --query-gpu=memory.total --format=csv,noheader 2>/dev/null | head -1 | grep -oP '\d+')
        compute_cap=$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader 2>/dev/null | head -1)
        pcie_gen=$(nvidia-smi --query-gpu=pcie.link.gen.current --format=csv,noheader 2>/dev/null | head -1)
        pcie_width=$(nvidia-smi --query-gpu=pcie.link.width.current --format=csv,noheader 2>/dev/null | head -1 | grep -oP '\d+')
    fi

    local cpu_model=""
    local has_avx2=false
    local ram_mib=0
    if [[ -f /proc/cpuinfo ]]; then
        cpu_model=$(grep -m1 "model name" /proc/cpuinfo | sed 's/.*: //')
        has_avx2=$(grep -c "avx2" /proc/cpuinfo &>/dev/null && echo true || echo false)
    fi
    if [[ -f /proc/meminfo ]]; then
        ram_mib=$(grep "^MemTotal" /proc/meminfo | awk '{print int($2/1024)}')
    fi

    local has_ipc_lock=false
    if [[ -x "$SERVER_BINARY" ]]; then
        local caps
        caps=$(getcap "$SERVER_BINARY" 2>/dev/null || true)
        [[ "$caps" == *"cap_ipc_lock"* ]] && has_ipc_lock=true
    fi

    cat > "$out" <<PROBE
{
  "probed_at": "$(date -Iseconds)",
  "gpus": [
    {
      "index": 0,
      "name": "$gpu_name",
      "vram_mib": ${vram_total:-0},
      "compute_cap": "${compute_cap:-unknown}",
      "pcie_gen": ${pcie_gen:-0},
      "pcie_width": ${pcie_width:-0}
    }
  ],
  "cpu": "${cpu_model:-unknown}",
  "has_avx2": $has_avx2,
  "ram_mib": $ram_mib,
  "gpu_count": ${gpu_count:-0},
  "has_ipc_lock": $has_ipc_lock
}
PROBE
    echo "$out"
}

calibrate_model_hash() {
    local model_path="$1"
    if [[ ! -f "$model_path" ]]; then
        echo ""
        return
    fi
    dd if="$model_path" bs=1M count=1 2>/dev/null | sha256sum | cut -d' ' -f1
}

calibrate_analyze_model() {
    local model_path="$1"
    local model_hash="$2"
    local out_dir="${CALIBRATION_DIR}/${model_hash}"
    mkdir -p "$out_dir"
    local out="${out_dir}/model.json"

    if [[ ! -f "$model_path" ]]; then
        echo '{"error": "model not found"}' > "$out"
        echo "$out"
        return
    fi

    local file_size_gb
    file_size_gb=$(stat --format=%s "$model_path" 2>/dev/null | LC_ALL=C awk '{printf "%.1f", $1/1073741824}')

    local model_data="{}"
    if command -v python3 &>/dev/null && [[ -f "$CALIBRATION_SCRIPT" ]]; then
        model_data=$(python3 "$CALIBRATION_SCRIPT" "$model_path" 2>/dev/null || echo "{}")
    fi

    local architecture
    architecture=$(echo "$model_data" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('architecture','unknown'))" 2>/dev/null || echo "unknown")

    local context_length
    context_length=$(echo "$model_data" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('context_length',0))" 2>/dev/null || echo 0)

    local block_count
    block_count=$(echo "$model_data" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('block_count',0))" 2>/dev/null || echo 0)

    local expert_count
    expert_count=$(echo "$model_data" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('expert_count',0))" 2>/dev/null || echo 0)

    local embedding_length
    embedding_length=$(echo "$model_data" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('embedding_length',0))" 2>/dev/null || echo 0)

    local has_mtp_str
    has_mtp_str=$(echo "$model_data" | python3 -c "import sys,json; d=json.load(sys.stdin); print('true' if d.get('has_mtp') else 'false')" 2>/dev/null || echo "false")

    local per_layer_attn
    per_layer_attn=$(echo "$model_data" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('per_layer_attn_mib',11))" 2>/dev/null || echo 11)

    local per_layer_experts
    per_layer_experts=$(echo "$model_data" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('per_layer_experts_mib',120))" 2>/dev/null || echo 120)

    local total_model_mib
    total_model_mib=$(echo "$model_data" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('total_size_mib',10240))" 2>/dev/null || echo 10240)

    [[ -z "$block_count" || "$block_count" -eq 0 ]] && block_count=40
    [[ -z "$expert_count" || "$expert_count" -eq 0 ]] && expert_count=256

    cat > "$out" <<ANALYSIS
{
  "model_hash": "$model_hash",
  "model_path": "$model_path",
  "file_size_gb": $file_size_gb,
  "architecture": "$architecture",
  "context_length": $context_length,
  "embedding_length": $embedding_length,
  "block_count": $block_count,
  "expert_count": $expert_count,
  "has_mtp": $has_mtp_str,
  "per_layer_attn_mib": $per_layer_attn,
  "per_layer_experts_mib": $per_layer_experts,
  "total_model_mib": $total_model_mib
}
ANALYSIS
    echo "$out"
}

calibrate_estimate_vram() {
    local hardware_json="$1"
    local model_json="$2"
    local model_hash
    model_hash=$(basename "$(dirname "$model_json")")
    local out="${CALIBRATION_DIR}/${model_hash}/bounds.json"

    if [[ -f "$CALIBRATION_SCRIPT" ]] && command -v python3 &>/dev/null; then
        local model_path
        model_path=$(python3 -c "import json; print(json.load(open('$model_json'))['model_path'])" 2>/dev/null || echo "")
        if [[ -n "$model_path" && -f "$model_path" ]]; then
            python3 "$CALIBRATION_SCRIPT" "$model_path" "$hardware_json" 2>/dev/null | python3 -c "
import sys, json
data = json.load(sys.stdin)
bounds = data['bounds']
with open('$out', 'w') as f:
    json.dump(bounds, f, indent=2)
" || true
        fi
    fi
    echo "$out"
}

calibrate_quick() {
    local model_path="$1"
    local profile_name="${2:-calibrated}"

    if [[ -z "$model_path" || ! -f "$model_path" ]]; then
        echo "ERROR: model not found: $model_path"
        echo "Usage: vitriol calibrate --quick --model <path>"
        return 1
    fi

    # Try Rust binary first
    if calibrate_use_rust; then
        "$CALIBRATE_BINARY" calibrate --quick --model "$model_path"
        local rc=$?
        if [[ $rc -eq 0 ]]; then
            return 0
        fi
        echo "Rust calibration failed (exit $rc), falling back to Python..."
    fi

    # Fallback: Python-based calibration
    if ! command -v python3 &>/dev/null; then
        echo "ERROR: python3 required for calibration (Rust binary not available)"
        return 1
    fi

    # Phase 1: Hardware probe
    echo "⚡ Probing hardware..."
    local hw_json
    hw_json=$(calibrate_probe_hardware)
    local hw_desc
    hw_desc=$(python3 -c "import json; d=json.load(open('$hw_json')); print(d['gpus'][0]['name'], d['gpus'][0]['vram_mib'], 'MiB')" 2>/dev/null || echo "done")
    echo "  → $hw_desc"

    # Phase 2: Model analysis
    echo "📦 Analyzing model..."
    local model_hash
    model_hash=$(calibrate_model_hash "$model_path")
    local model_json
    model_json=$(calibrate_analyze_model "$model_path" "$model_hash")
    local arch_desc
    arch_desc=$(python3 -c "import json; d=json.load(open('$model_json')); print(d.get('architecture','?') + ', ' + str(d.get('block_count',0)) + ' layers, ' + str(d.get('expert_count',0)) + ' experts')" 2>/dev/null || echo "done")
    echo "  → $arch_desc"

    # Phase 3: VRAM estimator
    echo "🧮 Estimating VRAM bounds..."
    local bounds_json
    bounds_json=$(calibrate_estimate_vram "$hw_json" "$model_json")
    if [[ -f "$bounds_json" ]]; then
        local opt_desc
        opt_desc=$(python3 -c "
import json
d=json.load(open('$bounds_json'))
o=d['optimal']
print(f\"pin{o['pin_first_n_layers']} ctx{o['context']} ubatch{o['ubatch_size']} MTP{o['draft_n_max']} — {o['estimated_vram_mib']} MiB ({o['estimated_vram_pct']}%)\")
" 2>/dev/null || echo "done")
        echo "  → Recommended: $opt_desc"
    fi

    # Save as profile
    echo "💾 Saving as profile '${profile_name}'..."
    local cal_desc="Calibrated"
    if [[ -f "$bounds_json" ]]; then
        cal_desc=$(python3 -c "
import json
o=json.load(open('$bounds_json'))['optimal']
print(f'pin{o[\"pin_first_n_layers\"]} ctx{o[\"context\"]} ubatch{o[\"ubatch_size\"]} MTP{o[\"draft_n_max\"]}')
" 2>/dev/null || echo "auto")
    fi
    profiles_save "$profile_name" "Calibrated: $cal_desc"

    echo ""
    echo "═══════════════════════════════════════════"
    echo "  Calibration complete!"
    echo ""
    echo "  Run: vitriol config load $profile_name"
    echo "  Then: vitriol stop && vitriol serve --detach"
    echo "═══════════════════════════════════════════"
}
# ═════════════════════════════════════════════════════════════════
# MAIN
# ═════════════════════════════════════════════════════════════════

# Parse config before command dispatch so env vars override
parse_config

CMD="${1:-tui}"
case "$CMD" in
    run)
        shift
        # CLI flags override config
        CLI_MODEL=""
        CLI_CTX=""
        CLI_THREADS=""
        CLI_NGL=""
        CLI_PORT=""
        CLI_LRU_MB=""
        CLI_VERBOSE=""
        CLI_MEMORY_MODE=""
        CLI_KV_MODE=""
        CLI_FROZEN_PROMPT=""
        CLI_SEMANTIC_MODE=""
        CLI_KV_QUANT=""
        CLI_LOOKUP=""
        CLI_ENGINE_MODE=""
        CLI_DISK_OFFLOAD=""
            CLI_SPEC_TYPE=""
            CLI_SPEC_DRAFT_N_MAX=""
            CLI_SPEC_DRAFT_MODEL=""
            CLI_SPEC_DRAFT_DEVICE=""
            CLI_SPEC_DRAFT_NGL=""
            CLI_TENSOR_SPLIT=""
            CLI_PIN_LAYERS=""
            CLI_PRUNE_EXPERTS=""
            CLI_UBATCH=""
            DRY_RUN=false

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -m) CLI_MODEL="$2"; shift 2 ;;
                    -c) CLI_CTX="$2"; shift 2 ;;
                    -t) CLI_THREADS="$2"; shift 2 ;;
                    -ngl) CLI_NGL="$2"; shift 2 ;;
                    -lru) CLI_LRU_MB="$2"; shift 2 ;;
                    -port) CLI_PORT="$2"; shift 2 ;;
                --cache-ram) CLI_CACHE_RAM="$2"; shift 2 ;;
                    --memory-mode) CLI_MEMORY_MODE="$2"; shift 2 ;;
                    --kv-mode) CLI_KV_MODE="$2"; shift 2 ;;
                    --frozen-prompt) CLI_FROZEN_PROMPT="$2"; shift 2 ;;
                    --semantic-mode) CLI_SEMANTIC_MODE="$2"; shift 2 ;;
                --kv-quant) CLI_KV_QUANT="$2"; shift 2 ;;
                --kv-quant-v) CLI_KV_QUANT_V="$2"; shift 2 ;;
                    --kv-quant-v) CLI_KV_QUANT_V="$2"; shift 2 ;;
                    --lookup) CLI_LOOKUP="$2"; shift 2 ;;
                    --engine-mode) CLI_ENGINE_MODE="$2"; shift 2 ;;
                    --spec-type) CLI_SPEC_TYPE="$2"; shift 2 ;;
                    --spec-draft-n-max) CLI_SPEC_DRAFT_N_MAX="$2"; shift 2 ;;
                    --spec-draft-model) CLI_SPEC_DRAFT_MODEL="$2"; shift 2 ;;
                    --spec-draft-device) CLI_SPEC_DRAFT_DEVICE="$2"; shift 2 ;;
                    --spec-draft-ngl) CLI_SPEC_DRAFT_NGL="$2"; shift 2 ;;
                    --tensor-split|-ts) CLI_TENSOR_SPLIT="$2"; shift 2 ;;
                    --verbose) CLI_VERBOSE="true"; shift ;;
                    --disk-offload) CLI_DISK_OFFLOAD="1"; shift ;;
                    --pin-layers) CLI_PIN_LAYERS="$2"; shift 2 ;;
                    --prune-experts) CLI_PRUNE_EXPERTS="$2"; shift 2 ;;
                    --ubatch-size) CLI_UBATCH="$2"; shift 2 ;;
                    --dry-run) DRY_RUN=true; shift;;
                    -h|--help) usage; exit 0 ;;
                    *) echo "Unknown: $1"; usage; exit 1 ;;
                esac
            done

        # Precedence: CLI > Config > Env > Default
        MODEL="${VITRIOL_MODEL:-${CLI_MODEL:-${CFG_MODEL}}}"
        MMPROJ="${VITRIOL_MMPROJ:-${CFG_MMPROJ:-}}"
        MMPROJ_ARGS=()
        [[ -n "${MMPROJ:-}" && -f "${MMPROJ:-}" ]] && MMPROJ_ARGS=(--mmproj "$MMPROJ")
        CTX="${CLI_CTX:-${CFG_CTX}}"
        THREADS="${CLI_THREADS:-${CFG_THREADS}}"
        NGL="${CLI_NGL:-${CFG_NGL}}"
        PORT="${CLI_PORT:-${CFG_PORT}}"
        LRU_MB="${CLI_LRU_MB:-${CFG_LRU_MB}}"
        MODE="${VITRIOL_MODE:-${CFG_MODE}}"
        MEMORY_MODE="${VITRIOL_MEMORY_MODE:-${CLI_MEMORY_MODE:-${CFG_MEMORY_MODE}}}"
        KV_MODE="${VITRIOL_KV_MODE:-${CLI_KV_MODE:-${CFG_KV_MODE}}}"
        KV_SCORE="${VITRIOL_KV_SCORE:-${CFG_KV_SCORE}}"
        KV_SCORE_EVERY="${VITRIOL_KV_SCORE_EVERY:-${CFG_KV_SCORE_EVERY}}"
        FROZEN_PROMPT="${VITRIOL_FROZEN_PROMPT:-${CLI_FROZEN_PROMPT:-${CFG_FROZEN_PROMPT}}}"
        SEMANTIC_MODE="${VITRIOL_SEMANTIC_MODE:-${CLI_SEMANTIC_MODE:-${CFG_SEMANTIC_MODE}}}"
        KV_QUANT="${CLI_KV_QUANT:-${CFG_KV_QUANT}}"
        LOOKUP="${CLI_LOOKUP:-${CFG_LOOKUP}}"
        ENGINE_MODE="${CLI_ENGINE_MODE:-${CLI_ENGINE_MODE:-${CFG_ENGINE_MODE}}}"
        KV_QUANT_V="${CLI_KV_QUANT_V:-${CFG_KV_QUANT_V}}"
DISK_OFFLOAD="${CLI_DISK_OFFLOAD:-0}"
        SPEC_TYPE="${CLI_SPEC_TYPE:-${CFG_SPEC_TYPE}}"
        SPEC_DRAFT_N_MAX="${CLI_SPEC_DRAFT_N_MAX:-${CFG_SPEC_DRAFT_N_MAX}}"
        SPEC_DRAFT_MODEL="${CLI_SPEC_DRAFT_MODEL:-${CFG_SPEC_DRAFT_MODEL}}"
        SPEC_DRAFT_DEVICE="${CLI_SPEC_DRAFT_DEVICE:-${CFG_SPEC_DRAFT_DEVICE}}"
        SPEC_DRAFT_NGL="${CLI_SPEC_DRAFT_NGL:-${CFG_SPEC_DRAFT_NGL}}"
        TENSOR_SPLIT="${CLI_TENSOR_SPLIT:-${CFG_TENSOR_SPLIT}}"
        EXPERT_COUNT="${CFG_EXPERT_COUNT}"
        OUTPUT_CACHE="${CFG_OUTPUT_CACHE}"
        REASONING="${CLI_REASONING:-${CFG_REASONING}}"
        PREDICTIVE_PREFETCH="${CFG_PREDICTIVE_PREFETCH}"
        PIN_FIRST_N_LAYERS="${CLI_PIN_LAYERS:-${CFG_PIN_FIRST_N_LAYERS}}"
        PRUNE_EXPERTS="${CLI_PRUNE_EXPERTS:-${CFG_PRUNE_EXPERTS}}"
        CHIMERA_MODE="${CLI_CHIMERA_MODE:-${CFG_CHIMERA_MODE}}"
        UBATCH="${CLI_UBATCH:-${CFG_UBATCH}}"
        CKPT_EVERY="${CLI_CKPT_EVERY:-${CFG_CKPT_EVERY:-2048}}"

        # VITRIOL-FINGERPRINT: canonical one-line config identity. Emitted to
        # console and (on real launches) appended to GEN_LOG so any log excerpt
        # answers "what flags produced this?" without archaeology.
        kv_sparse_guard
        FINGERPRINT=$(compute_fingerprint \
            "$(basename "$MODEL")" "${TENSOR_SPLIT:-none}" "${CTX:-?}" "$KV_QUANT" "$KV_QUANT_V" "${UBATCH:-256}" "$MODE" "$ENGINE_MODE" "$CKPT_EVERY" "$LRU_MB"             "$KV_MODE" "$KV_SCORE" "${VITRIOL_POOL_RESET:-0}"             "${SPEC_TYPE:-none}" "${SPEC_DRAFT_N_MAX:-0}")
        fingerprint_journal
        # Auto-disable output cache when pinning is active
        if [[ "${PIN_FIRST_N_LAYERS:-0}" -gt 0 ]] && [[ "$OUTPUT_CACHE" == "on" ]]; then
            OUTPUT_CACHE="off"
            echo "  → Output cache auto-disabled (pinning + output cache target different decode paths)"
        fi
        # Auto-disable pin pool at large contexts to free VRAM for KV cache + MTP head
        # Only applies when pin value comes from config (not CLI override)
        if [[ -z "${CLI_PIN_LAYERS:-}" ]] && [[ "${CTX:-8192}" -gt 65536 ]] && [[ "${PIN_FIRST_N_LAYERS:-0}" -gt 0 ]]; then
            echo "  → Pin layers auto-disabled (context ${CTX} > 64K — VRAM needed for KV cache)"
            PIN_FIRST_N_LAYERS=0
        fi
        VERBOSE="${CLI_VERBOSE:-${CFG_VERBOSE}}"
        DEVICE="${CFG_DEVICE}"

        if [[ "$CFG_EXCLUDE_SECONDARY" == "true" ]]; then
            CUDA_DEVICES="${DEVICE}"
        else
            CUDA_DEVICES="0,1"
        fi

        # Pre-flight
        if [[ ! -f "$MODEL" ]]; then
            echo "ERROR: model not found: $MODEL"
            echo "  Set with: vitriol config (option 2)"
            echo "  Or:       vitriol run -m /path/to/model.gguf"
            exit 1
        fi
        if [[ ! -x "$BINARY" ]]; then
            echo "ERROR: binary not found: $BINARY"
            echo "  Build with: cd llama.cpp && cmake -B build -DGGML_CUDA=ON ... && cmake --build build -j\$(nproc)"
            exit 1
        fi

        # 2026-08-24: downgraded from hard error to warning. Every deep-context
        # certification run that day executed WITHOUT the cap (CUDA pinned
        # allocations do not count against RLIMIT_MEMLOCK on this stack), so a
        # missing cap is not fatal. Keep 'sudo vitriol setup' available for
        # hosts where mlock does fail.
        CAPS=$(getcap "$BINARY" 2>/dev/null || true)
        if [[ "$CAPS" != *"cap_ipc_lock"* ]]; then
            echo "NOTE: CAP_IPC_LOCK not set on $BINARY (optional on this host)."
            echo "  If you ever see mlock/DMA failures: sudo vitriol setup"
        fi

        MODEL_SIZE=$(stat --format=%s "$MODEL" 2>/dev/null | numfmt --to=iec || echo "?")

        MEMORY_MODE="${VITRIOL_MEMORY_MODE:-${CFG_MEMORY_MODE}}"
        SEMANTIC_MODE="${VITRIOL_SEMANTIC_MODE:-${CFG_SEMANTIC_MODE}}"

        # Print launch banner
        clear 2>/dev/null || true
        [[ -f "$HEADER_FILE" ]] && cat "$HEADER_FILE"
        echo ""
        mtp_flag=""
        model_has_mtp "$MODEL" && mtp_flag=" [MTP]"
        GPU_LABEL=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | sed -n "$((DEVICE+1))p")
        echo "═══ Launch Configuration ═══"
        echo "  Model:       $(basename "$MODEL") ($MODEL_SIZE)${mtp_flag}"
        echo "  Context:     $CTX tokens"
        echo "  Mode:        $MODE (RAM Shot + LRU cache)"
        [[ "$LRU_MB" -gt 0 ]] && echo "  LRU:         $LRU_MB MB VRAM cache"
        echo "  GPU:         Device $DEVICE (${GPU_LABEL:-unknown})"
        [[ -n "${TENSOR_SPLIT:-}" ]] && echo "  Tensor Split: ${TENSOR_SPLIT}"
        echo "  Memory:      $MEMORY_MODE"
        echo "  KV Mode:     $KV_MODE"
        echo "  Frozen:      $FROZEN_PROMPT"
        echo "  Semantic:    $SEMANTIC_MODE"
        echo "  K Quant:     $KV_QUANT"
        echo "  V Quant:     ${KV_QUANT_V:-f16}"
        echo "  Lookup:      $LOOKUP"
        echo "  Engine:      $ENGINE_MODE"
        [[ -n "$SPEC_TYPE" ]] && echo "  Spec Type:   $SPEC_TYPE"
        [[ "${SPEC_DRAFT_N_MAX:-0}" -gt 0 ]] && echo "  Draft N-Max: $SPEC_DRAFT_N_MAX"
        [[ -n "$SPEC_DRAFT_MODEL" ]] && echo "  Draft Model: $(basename "$SPEC_DRAFT_MODEL")"
        [[ -n "$SPEC_DRAFT_DEVICE" ]] && echo "  Draft Device:$SPEC_DRAFT_DEVICE"
        echo "  Chimera:     ${CHIMERA_MODE:-auto}"
        [[ "${PIN_FIRST_N_LAYERS:-0}" -gt 0 ]] && echo "  Pin Layers:  $PIN_FIRST_N_LAYERS (expert tensors in VRAM)"
        if [[ "${PRUNE_EXPERTS:-0}" -gt 0 ]]; then
            prune_keep=$((8 - PRUNE_EXPERTS))
            echo "  Expert Prune: $PRUNE_EXPERTS (keeping $prune_keep of 8)"
        fi
        [[ "${REASONING}" == "off" ]] && echo "  Reasoning:    off (Qwen3.6 mode)"
        echo "  Binary:      $BINARY"
        echo "  Port:        $PORT"
        [[ "$VERBOSE" == "true" ]] && echo "  Logging:     verbose"
        echo "  $FINGERPRINT"
        echo "═══════════════════════════════"
        echo ""

        if $DRY_RUN; then
            exit 0
        fi

        echo "Launching VITRIOL..."
        echo "  Model loading takes ~60s for 12 GB model"
        echo ""

        ENV_VERBOSE=""
        [[ "$VERBOSE" == "true" ]] && ENV_VERBOSE="VITRIOL_VERBOSE=1"
        ENV_PREDICTIVE_PREFETCH=""
        [[ "$PREDICTIVE_PREFETCH" == "on" ]] && ENV_PREDICTIVE_PREFETCH="VITRIOL_PREDICTIVE_PREFETCH=1"

        exec env \
            CUDA_VISIBLE_DEVICES="$CUDA_DEVICES" \
            VITRIOL_MODE="$MODE" \
            VITRIOL_LRU_MB="$LRU_MB" \
            VITRIOL_MEMORY_MODE="$MEMORY_MODE" \
            VITRIOL_KV_MODE="$KV_MODE" \
            VITRIOL_KV_SCORE="$KV_SCORE" \
            VITRIOL_KV_SCORE_EVERY="$KV_SCORE_EVERY" \
            VITRIOL_FROZEN_PROMPT="$FROZEN_PROMPT" \
            VITRIOL_SEMANTIC_MODE="$SEMANTIC_MODE" \
            VITRIOL_KV_QUANT="$KV_QUANT" \
            VITRIOL_LOOKUP="$LOOKUP" \
            VITRIOL_ENGINE_MODE="$ENGINE_MODE" \
            VITRIOL_DISK_OFFLOAD="$DISK_OFFLOAD" \
            VITRIOL_EXPERT_COUNT="$EXPERT_COUNT" \
            VITRIOL_OUTPUT_CACHE="$OUTPUT_CACHE" \
            VITRIOL_PIN_FIRST_N_LAYERS="$PIN_FIRST_N_LAYERS" \
            VITRIOL_PRUNE_EXPERTS="$PRUNE_EXPERTS" \
            VITRIOL_EARLY_EXIT="${VITRIOL_EARLY_EXIT:-0}" \
            VITRIOL_EARLY_EXIT_THRESHOLD="${VITRIOL_EARLY_EXIT_THRESHOLD:-0.001}" \
            VITRIOL_EARLY_EXIT_MIN_LAYERS="${VITRIOL_EARLY_EXIT_MIN_LAYERS:-10}" \
            VITRIOL_MODEL_PATH="$MODEL" \
            VITRIOL_CHIMERA_MODE="$CHIMERA_MODE" \
                    LD_LIBRARY_PATH="${LLAMA_DIR}/build/bin${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
            $ENV_VERBOSE \
            $ENV_PREDICTIVE_PREFETCH \
            "$BINARY" \
            -m "$MODEL" \
            -ngl "$NGL" \
            -c "$CTX" \
            -n 128 \
            -t "$THREADS" \
            ${TENSOR_SPLIT:+-ts $TENSOR_SPLIT} \
            "$@"
        ;;

    serve)
        shift
        CLI_MODEL=""
        CLI_CTX=""
        CLI_THREADS=""
        CLI_NGL=""
        CLI_LRU_MB=""
        CLI_PORT=""
        CLI_HOST=""
        CLI_PARALLEL=""
        CLI_VERBOSE=""
        CLI_MEMORY_MODE=""
        CLI_KV_MODE=""
        CLI_FROZEN_PROMPT=""
        CLI_SEMANTIC_MODE=""
        CLI_KV_QUANT=""
        CLI_LOOKUP=""
        CLI_ENGINE_MODE=""
        CLI_DISK_OFFLOAD=""
        CLI_SPEC_TYPE=""
        CLI_SPEC_DRAFT_N_MAX=""
        CLI_SPEC_DRAFT_MODEL=""
        CLI_SPEC_DRAFT_DEVICE=""
        CLI_SPEC_DRAFT_NGL=""
        CLI_TENSOR_SPLIT=""
        CLI_UBATCH=""
        CLI_PIN_LAYERS=""
        CLI_PRUNE_EXPERTS=""
        CLI_REASONING=""
        DETACH=false
        DRY_RUN=false

        while [[ $# -gt 0 ]]; do
            case "$1" in
                -m) CLI_MODEL="$2"; shift 2 ;;
                -c) CLI_CTX="$2"; shift 2 ;;
                -t) CLI_THREADS="$2"; shift 2 ;;
                -ngl) CLI_NGL="$2"; shift 2 ;;
                -lru) CLI_LRU_MB="$2"; shift 2 ;;
                --host) CLI_HOST="$2"; shift 2 ;;
                -port) CLI_PORT="$2"; shift 2 ;;
                --cache-ram) CLI_CACHE_RAM="$2"; shift 2 ;;
                -p) CLI_PARALLEL="$2"; shift 2 ;;
                --memory-mode) CLI_MEMORY_MODE="$2"; shift 2 ;;
                --kv-mode) CLI_KV_MODE="$2"; shift 2 ;;
                --frozen-prompt) CLI_FROZEN_PROMPT="$2"; shift 2 ;;
                --semantic-mode) CLI_SEMANTIC_MODE="$2"; shift 2 ;;
                --kv-quant) CLI_KV_QUANT="$2"; shift 2 ;;
                --lookup) CLI_LOOKUP="$2"; shift 2 ;;
                --engine-mode) CLI_ENGINE_MODE="$2"; shift 2 ;;
                --spec-type) CLI_SPEC_TYPE="$2"; shift 2 ;;
                --spec-draft-n-max) CLI_SPEC_DRAFT_N_MAX="$2"; shift 2 ;;
                --spec-draft-model) CLI_SPEC_DRAFT_MODEL="$2"; shift 2 ;;
                --spec-draft-device) CLI_SPEC_DRAFT_DEVICE="$2"; shift 2 ;;
                --spec-draft-ngl) CLI_SPEC_DRAFT_NGL="$2"; shift 2 ;;
                --tensor-split|-ts) CLI_TENSOR_SPLIT="$2"; shift 2 ;;
                --ubatch-size) CLI_UBATCH="$2"; shift 2 ;;
                --disk-offload) CLI_DISK_OFFLOAD="1"; shift ;;
                --pin-layers) CLI_PIN_LAYERS="$2"; shift 2 ;;
                --prune-experts) CLI_PRUNE_EXPERTS="$2"; shift 2 ;;
                --reasoning) CLI_REASONING="$2"; shift 2 ;;
                --detach) DETACH=true; shift ;;
                --verbose) CLI_VERBOSE="true"; shift ;;
                --dry-run) DRY_RUN=true; shift;;
                -h|--help) usage; exit 0 ;;
                *) echo "Unknown: $1"; usage; exit 1 ;;
            esac
        done

        MODEL="${VITRIOL_MODEL:-${CLI_MODEL:-${CFG_MODEL}}}"
        MMPROJ="${VITRIOL_MMPROJ:-${CFG_MMPROJ:-}}"
        MMPROJ_ARGS=()
        [[ -n "${MMPROJ:-}" && -f "${MMPROJ:-}" ]] && MMPROJ_ARGS=(--mmproj "$MMPROJ")
        CTX="${CLI_CTX:-${CFG_CTX}}"
        THREADS="${CLI_THREADS:-${CFG_THREADS}}"
        NGL="${CLI_NGL:-${CFG_NGL}}"
        LRU_MB="${CLI_LRU_MB:-${CFG_LRU_MB}}"
        PORT="${CLI_PORT:-${CFG_PORT}}"
        HOST="${CLI_HOST:-${CFG_HOST}}"
        PARALLEL="${CLI_PARALLEL:-${CFG_PARALLEL}}"
        SLOT_CONTEXT="${CLI_SLOT_CONTEXT:-${CFG_SLOT_CONTEXT:-}}"
        SLOT_SAVE_PATH="${CLI_SLOT_SAVE_PATH:-${CFG_SLOT_SAVE_PATH:-}}"
        CACHE_RAM="${CLI_CACHE_RAM:-${CFG_CACHE_RAM:-}}"
        CHAT_TEMPLATE="${CFG_CHAT_TEMPLATE:-}"
        MODE="${VITRIOL_MODE:-${CFG_MODE}}"
        MEMORY_MODE="${VITRIOL_MEMORY_MODE:-${CLI_MEMORY_MODE:-${CFG_MEMORY_MODE}}}"
        KV_MODE="${VITRIOL_KV_MODE:-${CLI_KV_MODE:-${CFG_KV_MODE}}}"
        KV_SCORE="${VITRIOL_KV_SCORE:-${CFG_KV_SCORE}}"
        KV_SCORE_EVERY="${VITRIOL_KV_SCORE_EVERY:-${CFG_KV_SCORE_EVERY}}"
        FROZEN_PROMPT="${VITRIOL_FROZEN_PROMPT:-${CLI_FROZEN_PROMPT:-${CFG_FROZEN_PROMPT}}}"
        SEMANTIC_MODE="${VITRIOL_SEMANTIC_MODE:-${CLI_SEMANTIC_MODE:-${CFG_SEMANTIC_MODE}}}"
        KV_QUANT="${CLI_KV_QUANT:-${CFG_KV_QUANT}}"
        LOOKUP="${CLI_LOOKUP:-${CFG_LOOKUP}}"
        ENGINE_MODE="${CLI_ENGINE_MODE:-${CLI_ENGINE_MODE:-${CFG_ENGINE_MODE}}}"
        KV_QUANT_V="${CLI_KV_QUANT_V:-${CFG_KV_QUANT_V}}"
        DISK_OFFLOAD="${CLI_DISK_OFFLOAD:-0}"
        SPEC_TYPE="${CLI_SPEC_TYPE:-${CFG_SPEC_TYPE}}"
        SPEC_DRAFT_N_MAX="${CLI_SPEC_DRAFT_N_MAX:-${CFG_SPEC_DRAFT_N_MAX}}"
        SPEC_DRAFT_MODEL="${CLI_SPEC_DRAFT_MODEL:-${CFG_SPEC_DRAFT_MODEL}}"
        SPEC_DRAFT_DEVICE="${CLI_SPEC_DRAFT_DEVICE:-${CFG_SPEC_DRAFT_DEVICE}}"
        SPEC_DRAFT_NGL="${CLI_SPEC_DRAFT_NGL:-${CFG_SPEC_DRAFT_NGL}}"
        TENSOR_SPLIT="${CLI_TENSOR_SPLIT:-${CFG_TENSOR_SPLIT}}"
        EXPERT_COUNT="${CFG_EXPERT_COUNT}"
        OUTPUT_CACHE="${CFG_OUTPUT_CACHE}"
        UBATCH="${CLI_UBATCH:-${CFG_UBATCH}}"
        CKPT_EVERY="${CLI_CKPT_EVERY:-${CFG_CKPT_EVERY:-2048}}"
        kv_sparse_guard
        serve_unit_guard
        FINGERPRINT=$(compute_fingerprint \
            "$(basename "$MODEL")" "${TENSOR_SPLIT:-none}" "${CTX:-?}" "$KV_QUANT" "$KV_QUANT_V" "${UBATCH:-256}" "$MODE" "$ENGINE_MODE" "$CKPT_EVERY" "$LRU_MB" \
            "$KV_MODE" "$KV_SCORE" "${VITRIOL_POOL_RESET:-0}" "${SPEC_TYPE:-none}" "${SPEC_DRAFT_N_MAX:-0}")
        [[ -n "${SLOT_CONTEXT:-}" ]] && FINGERPRINT="$FINGERPRINT slots=$SLOT_CONTEXT"
        [[ -n "${SLOT_SAVE_PATH:-}" ]] && FINGERPRINT="$FINGERPRINT ssp=1"
        [[ -n "${CACHE_RAM:-}" ]] && FINGERPRINT="$FINGERPRINT cram=$CACHE_RAM"
        [[ -n "${CHAT_TEMPLATE:-}" ]] && FINGERPRINT="$FINGERPRINT ct=$(basename "$CHAT_TEMPLATE")"
        [[ ${#MMPROJ_ARGS[@]} -gt 0 ]] && FINGERPRINT="$FINGERPRINT vis=on"
        [[ "${CFG_CACHE_IDLE_SLOTS:-on}" == "off" ]] && FINGERPRINT="$FINGERPRINT cis=0"
        fingerprint_journal
        REASONING="${CFG_REASONING}"
        PREDICTIVE_PREFETCH="${CFG_PREDICTIVE_PREFETCH}"
        PIN_FIRST_N_LAYERS="${CLI_PIN_LAYERS:-${CFG_PIN_FIRST_N_LAYERS}}"
        PRUNE_EXPERTS="${CLI_PRUNE_EXPERTS:-${CFG_PRUNE_EXPERTS}}"
        # Auto-disable output cache when pinning is active (1)
        if [[ "${PIN_FIRST_N_LAYERS:-0}" -gt 0 ]] && [[ "$OUTPUT_CACHE" == "on" ]]; then
            OUTPUT_CACHE="off"
            echo "  → Output cache auto-disabled (pinning + output cache target different decode paths)"
        fi
        if [[ -z "${CLI_PIN_LAYERS:-}" ]] && [[ "${CTX:-8192}" -gt 65536 ]] && [[ "${PIN_FIRST_N_LAYERS:-0}" -gt 0 ]]; then
            echo "  → Pin layers auto-disabled (context ${CTX} > 64K — VRAM needed for KV cache)"
            PIN_FIRST_N_LAYERS=0
        fi
        VERBOSE="${CLI_VERBOSE:-${CFG_VERBOSE}}"
        DEVICE="${CFG_DEVICE}"

        if [[ "$CFG_EXCLUDE_SECONDARY" == "true" ]]; then
            CUDA_DEVICES="${DEVICE}"
        else
            CUDA_DEVICES="0,1"
        fi

        if [[ ! -f "$MODEL" ]]; then
            echo "ERROR: model not found: $MODEL"
            echo "  Set with: vitriol config (option 2)"
            exit 1
        fi
        if [[ ! -x "$SERVER_BINARY" ]]; then
            echo "ERROR: server binary not found: $SERVER_BINARY"
            echo "  Build with: cd llama.cpp && cmake -B build -DGGML_CUDA=ON ... && cmake --build build -j\$(nproc)"
            exit 1
        fi

        # Check caps for server binary too (warning only — see note above)
        SERVER_CAPS=$(getcap "$SERVER_BINARY" 2>/dev/null || true)
        if [[ "$SERVER_CAPS" != *"cap_ipc_lock"* ]]; then
            echo "NOTE: CAP_IPC_LOCK not set on $SERVER_BINARY (optional on this host)."
            echo "  If you ever see mlock/DMA failures: sudo vitriol setup"
        fi

        MODEL_SIZE=$(stat --format=%s "$MODEL" 2>/dev/null | numfmt --to=iec || echo "?")

        clear 2>/dev/null || true
        [[ -f "$HEADER_FILE" ]] && cat "$HEADER_FILE"
        echo ""
        mtp_flag=""
        model_has_mtp "$MODEL" && mtp_flag=" [MTP]"
        GPU_LABEL=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null | sed -n "$((DEVICE+1))p")
        echo "═══ VITRIOL Server ═══"
        echo "  Model:       $(basename "$MODEL") ($MODEL_SIZE)${mtp_flag}"
        echo "  Context:     $CTX tokens"
        echo "  Mode:        $MODE (RAM Shot + LRU cache)"
        [[ "$LRU_MB" -gt 0 ]] && echo "  LRU:         $LRU_MB MB VRAM cache"
        echo "  GPU:         Device $DEVICE (${GPU_LABEL:-unknown})"
        [[ -n "${TENSOR_SPLIT:-}" ]] && echo "  Tensor Split: ${TENSOR_SPLIT}"
        echo "  Memory:      $MEMORY_MODE"
        echo "  KV Mode:     $KV_MODE"
        echo "  Frozen:      $FROZEN_PROMPT"
        echo "  Semantic:    $SEMANTIC_MODE"
        echo "  K Quant:     $KV_QUANT"
        echo "  V Quant:     ${KV_QUANT_V:-f16}"
        echo "  Lookup:      $LOOKUP"
        echo "  Engine:      $ENGINE_MODE"
        [[ -n "$SPEC_TYPE" ]] && echo "  Spec Type:   $SPEC_TYPE"
        [[ "${SPEC_DRAFT_N_MAX:-0}" -gt 0 ]] && echo "  Draft N-Max: $SPEC_DRAFT_N_MAX"
        [[ -n "$SPEC_DRAFT_MODEL" ]] && echo "  Draft Model: $(basename "$SPEC_DRAFT_MODEL")"
        [[ -n "$SPEC_DRAFT_DEVICE" ]] && echo "  Draft Device:$SPEC_DRAFT_DEVICE"
        echo "  Chimera:     ${CHIMERA_MODE:-auto}"
        [[ "${PIN_FIRST_N_LAYERS:-0}" -gt 0 ]] && echo "  Pin Layers:  $PIN_FIRST_N_LAYERS (expert tensors in VRAM)"
        if [[ "${PRUNE_EXPERTS:-0}" -gt 0 ]]; then
            prune_keep=$((8 - PRUNE_EXPERTS))
            echo "  Expert Prune: $PRUNE_EXPERTS (keeping $prune_keep of 8)"
        fi
        [[ "${REASONING}" == "off" ]] && echo "  Reasoning:    off (Qwen3.6 mode)"
        if [[ "$MEMORY_MODE" == "on" ]]; then
            LLAMA_PORT=$((PORT - 1))
            echo "  Server:      http://${HOST}:${LLAMA_PORT} (llama-server, internal)"
            echo "  Proxy:       http://${HOST}:${PORT} (VITRIOL shim, memory intercept)"
        else
            echo "  Server:      http://${HOST}:${PORT}"
        fi
        echo "  Slots:     $PARALLEL parallel"
        [[ "$VERBOSE" == "true" ]] && echo "  Logging:   verbose"
        echo "  $FINGERPRINT"
        echo "═══════════════════════════"
        echo ""

        if $DRY_RUN; then
            exit 0
        fi

        ENV_VERBOSE=""
        [[ "$VERBOSE" == "true" ]] && ENV_VERBOSE="VITRIOL_VERBOSE=1"
        ENV_PREDICTIVE_PREFETCH=""
        [[ "$PREDICTIVE_PREFETCH" == "on" ]] && ENV_PREDICTIVE_PREFETCH="VITRIOL_PREDICTIVE_PREFETCH=1"

        # KV cache quant args (pass to llama-server as --cache-type-k and --cache-type-v)
        # NOTE: Setting --cache-type-v to q8_0 or q4_0 may produce garbage output with
        # VITRIOL expert offloading — leave V at f16 unless you've verified it works.
        KV_CACHE_ARGS=""
        [[ "$KV_QUANT" != "f16" ]] && KV_CACHE_ARGS="--cache-type-k $KV_QUANT"
        [[ "${KV_QUANT_V:-f16}" != "f16" ]] && KV_CACHE_ARGS="$KV_CACHE_ARGS --cache-type-v $KV_QUANT_V"
        # Speculative decoding args
        SPEC_ARGS=""
        [[ -n "$SPEC_TYPE" ]] && SPEC_ARGS="--spec-type $SPEC_TYPE"
        [[ "${SPEC_DRAFT_N_MAX:-0}" -gt 0 ]] && SPEC_ARGS="$SPEC_ARGS --spec-draft-n-max $SPEC_DRAFT_N_MAX"
        [[ -n "$SPEC_DRAFT_MODEL" ]] && SPEC_ARGS="$SPEC_ARGS --spec-draft-model $SPEC_DRAFT_MODEL"
        [[ -n "$SPEC_DRAFT_DEVICE" ]] && SPEC_ARGS="$SPEC_ARGS --spec-draft-device $SPEC_DRAFT_DEVICE"
         [[ -n "$SPEC_DRAFT_NGL" ]] && SPEC_ARGS="$SPEC_ARGS --spec-draft-ngl $SPEC_DRAFT_NGL"
         # Multi-GPU tensor split args
         TS_ARGS=""
        [[ -n "${TENSOR_SPLIT:-}" ]] && TS_ARGS="-ts ${TENSOR_SPLIT}"
        # Model alias: name reported via /v1/models and matched in requests
        MODEL_ALIAS="${CFG_MODEL_ALIAS:-${VITRIOL_MODEL_ALIAS:-}}"
        ALIAS_ARGS=()
        [[ -n "$MODEL_ALIAS" ]] && ALIAS_ARGS=(--alias "$MODEL_ALIAS")
        # Per-slot context caps (upstream PR #23340 port)
        SLOT_CTX_ARGS=()
        [[ -n "$SLOT_CONTEXT" ]] && SLOT_CTX_ARGS=(--slot-context "$SLOT_CONTEXT")
        # Disk-persistent slot checkpoints (restore via lull_slot_persist.py)
        SSP_ARGS=()
        # 2026-08-29: llama-server hard-fails if the path is not an existing dir
        # ("error while handling argument --slot-save-path: not a directory"),
        # which took down first-boot smoke after profiles gained slot_save_path.
        [[ -n "$SLOT_SAVE_PATH" ]] && mkdir -p "$SLOT_SAVE_PATH" && SSP_ARGS=(--slot-save-path "$SLOT_SAVE_PATH")
        # DRAM prompt-cache cap: default entitlement (8192 MiB) starved zram on
        # the 16 GiB host and caused swap-spill hangs
        CRAM_ARGS=()
        [[ -n "$CACHE_RAM" ]] && CRAM_ARGS=(--cache-ram "$CACHE_RAM")
        # Custom chat template (tolerant variants for clients that send system
        # messages mid-conversation, e.g. opencode plan agent)
        CHAT_TEMPLATE_ARGS=()
        [[ -n "$CHAT_TEMPLATE" ]] && CHAT_TEMPLATE_ARGS=(--chat-template-file "$CHAT_TEMPLATE")
        # Checkpoint interval: create checkpoints every 2048 tokens during prefill.
        # Combined with the LCP-boundary checkpoint (added at keep_first), this ensures
        # the next request's common prefix always lands within ~2048 tokens of a checkpoint.
        # 2026-09-03: flag remapped for the lull engine (--checkpoint-min-step
        # is the main-tree name; lull wants --checkpoint-every-n-tokens).
        CKPT_ARGS="--checkpoint-every-n-tokens ${CKPT_EVERY:-2048}"
        # Flash Attention is required for V cache quantization and generally faster
        FA_ARGS="-fa on"
        # Prefill optimization flags
        #   --kv-unified: shared KV buffer across sequences (required for cache-idle-slots)
        #   --cache-idle-slots: persist full state (incl. RS/SSM buffers) on slot release
        #   --ubatch-size 256: reduce compute buffer pressure, may reduce graph splits
        if [[ "${CFG_CACHE_IDLE_SLOTS:-on}" == "off" ]]; then
            CACHE_ARGS="--kv-unified --ubatch-size ${UBATCH:-256}"
        else
            CACHE_ARGS="--kv-unified --cache-idle-slots --ubatch-size ${UBATCH:-256}"
        fi
        # Reasoning/thinking mode: off for Qwen3.6 models
        REASONING_ARGS=""
        [[ "${REASONING}" == "off" ]] && REASONING_ARGS="--reasoning off"

        if $DETACH; then
            echo "Starting server in background..."
            mkdir -p "$CONFIG_DIR" "$TELEMETRY_LOG_DIR"
            SHIM_DIR="$(dirname "$SCRIPT_DIR")/libvitriol"
            export LD_LIBRARY_PATH="${LLAMA_DIR}/build/bin${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

            if [[ "$MEMORY_MODE" == "on" ]]; then
                LLAMA_PORT=$((PORT - 1))
                # Start llama-server on internal port
                env \
                    CUDA_VISIBLE_DEVICES="$CUDA_DEVICES" \
                    VITRIOL_MODE="$MODE" \
                    VITRIOL_LRU_MB="$LRU_MB" \
                    VITRIOL_KV_MODE="$KV_MODE" \
                    VITRIOL_KV_SCORE="$KV_SCORE" \
                    VITRIOL_KV_SCORE_EVERY="$KV_SCORE_EVERY" \
                    VITRIOL_FROZEN_PROMPT="$FROZEN_PROMPT" \
                    VITRIOL_SEMANTIC_MODE="$SEMANTIC_MODE" \
                    VITRIOL_KV_QUANT="$KV_QUANT" \
                    VITRIOL_LOOKUP="$LOOKUP" \
                    VITRIOL_ENGINE_MODE="$ENGINE_MODE" \
                    VITRIOL_DISK_OFFLOAD="$DISK_OFFLOAD" \
                    VITRIOL_EXPERT_COUNT="$EXPERT_COUNT" \
                    VITRIOL_OUTPUT_CACHE="$OUTPUT_CACHE" \
                    VITRIOL_PIN_FIRST_N_LAYERS="$PIN_FIRST_N_LAYERS" \
            VITRIOL_PRUNE_EXPERTS="$PRUNE_EXPERTS" \
            VITRIOL_EARLY_EXIT="${VITRIOL_EARLY_EXIT:-0}" \
            VITRIOL_EARLY_EXIT_THRESHOLD="${VITRIOL_EARLY_EXIT_THRESHOLD:-0.001}" \
            VITRIOL_EARLY_EXIT_MIN_LAYERS="${VITRIOL_EARLY_EXIT_MIN_LAYERS:-10}" \
                    VITRIOL_MODEL_PATH="$MODEL" \
                    LD_LIBRARY_PATH="${LLAMA_DIR}/build/bin${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
                    $ENV_VERBOSE \
                    $ENV_PREDICTIVE_PREFETCH \
                    nohup "$SERVER_BINARY" \
                        -m "$MODEL" \
                        -ngl "$NGL" \
                        -c "$CTX" \
                        --host "$HOST" \
                        --port "$LLAMA_PORT" \
                        --parallel "$PARALLEL" \
                        "${SLOT_CTX_ARGS[@]}" \
                        "${SSP_ARGS[@]}" \
                        "${CRAM_ARGS[@]}" \
                        "${CHAT_TEMPLATE_ARGS[@]}" \
                        "${MMPROJ_ARGS[@]}" \
                        --slots --metrics \
                        --no-mmap \
                         -t "$THREADS" \
                            $KV_CACHE_ARGS $FA_ARGS $SPEC_ARGS $TS_ARGS "${ALIAS_ARGS[@]}" $REASONING_ARGS $CKPT_ARGS $CACHE_ARGS \
                            "$@" &>"$GEN_LOG" &
                            printf '%s\n' "$FINGERPRINT" >> "$GEN_LOG"
                echo $! > "${CONFIG_DIR}/llama-server.pid"
                echo "  llama-server PID: $! (internal port $LLAMA_PORT)"

                # Start Python shim on external port
                env \
                    VITRIOL_MEMORY_MODE=on \
                    VITRIOL_KV_MODE="$KV_MODE" \
                    VITRIOL_KV_SCORE="$KV_SCORE" \
                    VITRIOL_KV_SCORE_EVERY="$KV_SCORE_EVERY" \
                    VITRIOL_FROZEN_PROMPT="$FROZEN_PROMPT" \
                    VITRIOL_SEMANTIC_MODE="$SEMANTIC_MODE" \
                    VITRIOL_KV_QUANT="$KV_QUANT" \
                    VITRIOL_LOOKUP="$LOOKUP" \
                    VITRIOL_ENGINE_MODE="$ENGINE_MODE" \
                    LLAMA_API_URL="http://${HOST}:${LLAMA_PORT}/v1/chat/completions" \
                    LLAMA_STATUS_URL="http://${HOST}:${LLAMA_PORT}/health" \
                    SHIM_PORT="$PORT" \
                    nohup python3 "$SHIM_DIR/vitriol_shim.py" \
                        &>"${CONFIG_DIR}/shim.log" &
                echo $! > "${CONFIG_DIR}/shim.pid"
                echo "  VITRIOL shim PID: $! (memory on port $PORT)"
            else
                # Start llama-server on external port directly
                env \
                    CUDA_VISIBLE_DEVICES="$CUDA_DEVICES" \
                    VITRIOL_MODE="$MODE" \
                    VITRIOL_LRU_MB="$LRU_MB" \
                    VITRIOL_KV_MODE="$KV_MODE" \
                    VITRIOL_KV_SCORE="$KV_SCORE" \
                    VITRIOL_KV_SCORE_EVERY="$KV_SCORE_EVERY" \
                    VITRIOL_FROZEN_PROMPT="$FROZEN_PROMPT" \
                    VITRIOL_SEMANTIC_MODE="$SEMANTIC_MODE" \
                    VITRIOL_KV_QUANT="$KV_QUANT" \
                    VITRIOL_LOOKUP="$LOOKUP" \
                    VITRIOL_ENGINE_MODE="$ENGINE_MODE" \
                    VITRIOL_DISK_OFFLOAD="$DISK_OFFLOAD" \
                    VITRIOL_EXPERT_COUNT="$EXPERT_COUNT" \
                    VITRIOL_OUTPUT_CACHE="$OUTPUT_CACHE" \
                    VITRIOL_PIN_FIRST_N_LAYERS="$PIN_FIRST_N_LAYERS" \
            VITRIOL_PRUNE_EXPERTS="$PRUNE_EXPERTS" \
            VITRIOL_EARLY_EXIT="${VITRIOL_EARLY_EXIT:-0}" \
            VITRIOL_EARLY_EXIT_THRESHOLD="${VITRIOL_EARLY_EXIT_THRESHOLD:-0.001}" \
            VITRIOL_EARLY_EXIT_MIN_LAYERS="${VITRIOL_EARLY_EXIT_MIN_LAYERS:-10}" \
                    VITRIOL_MODEL_PATH="$MODEL" \
                    LD_LIBRARY_PATH="${LLAMA_DIR}/build/bin${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
                    $ENV_VERBOSE \
                    $ENV_PREDICTIVE_PREFETCH \
                    nohup "$SERVER_BINARY" \
                        -m "$MODEL" \
                        -ngl "$NGL" \
                        -c "$CTX" \
                        --host "$HOST" \
                        --port "$PORT" \
                        --parallel "$PARALLEL" \
                        "${SLOT_CTX_ARGS[@]}" \
                        "${SSP_ARGS[@]}" \
                        "${CRAM_ARGS[@]}" \
                        "${CHAT_TEMPLATE_ARGS[@]}" \
                        "${MMPROJ_ARGS[@]}" \
                        --slots --metrics \
                        --no-mmap \
                        -t "$THREADS" \
                        $KV_CACHE_ARGS $FA_ARGS $SPEC_ARGS $TS_ARGS "${ALIAS_ARGS[@]}" $REASONING_ARGS $CKPT_ARGS $CACHE_ARGS \
                        "$@" &>"$GEN_LOG" &
                            printf '%s\n' "$FINGERPRINT" >> "$GEN_LOG"
                echo $! > "${CONFIG_DIR}/server.pid"
                echo "  Server PID: $!"
            fi

            echo "  Log:       $GEN_LOG"
            echo ""
            echo "  curl http://${HOST}:${PORT}/v1/chat/completions \\"
            echo "    -H \"Content-Type: application/json\" \\"
            echo "    -H \"X-Project-Id: my_project\" \\"
            echo "    -H \"X-Session-Id: my_session\" \\"
            echo "    -d '{\"messages\":[{\"role\":\"user\",\"content\":\"Hello\"}],\"max_tokens\":50}'"
        else
            echo "Starting server (Ctrl+C to stop)..."
            echo ""
            export LD_LIBRARY_PATH="${LLAMA_DIR}/build/bin${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

            if [[ "$MEMORY_MODE" == "on" ]]; then
                LLAMA_PORT=$((PORT - 1))
                SHIM_DIR="$(dirname "$SCRIPT_DIR")/libvitriol"

                # Start llama-server in background on internal port
                env \
                    CUDA_VISIBLE_DEVICES="$CUDA_DEVICES" \
                    VITRIOL_MODE="$MODE" \
                    VITRIOL_LRU_MB="$LRU_MB" \
                    VITRIOL_KV_MODE="$KV_MODE" \
                    VITRIOL_KV_SCORE="$KV_SCORE" \
                    VITRIOL_KV_SCORE_EVERY="$KV_SCORE_EVERY" \
                    VITRIOL_FROZEN_PROMPT="$FROZEN_PROMPT" \
                    VITRIOL_SEMANTIC_MODE="$SEMANTIC_MODE" \
                    VITRIOL_KV_QUANT="$KV_QUANT" \
                    VITRIOL_LOOKUP="$LOOKUP" \
                    VITRIOL_ENGINE_MODE="$ENGINE_MODE" \
                    VITRIOL_DISK_OFFLOAD="$DISK_OFFLOAD" \
                    VITRIOL_EXPERT_COUNT="$EXPERT_COUNT" \
                    VITRIOL_OUTPUT_CACHE="$OUTPUT_CACHE" \
                    VITRIOL_PIN_FIRST_N_LAYERS="$PIN_FIRST_N_LAYERS" \
            VITRIOL_PRUNE_EXPERTS="$PRUNE_EXPERTS" \
            VITRIOL_EARLY_EXIT="${VITRIOL_EARLY_EXIT:-0}" \
            VITRIOL_EARLY_EXIT_THRESHOLD="${VITRIOL_EARLY_EXIT_THRESHOLD:-0.001}" \
            VITRIOL_EARLY_EXIT_MIN_LAYERS="${VITRIOL_EARLY_EXIT_MIN_LAYERS:-10}" \
                    VITRIOL_MODEL_PATH="$MODEL" \
                    LD_LIBRARY_PATH="${LLAMA_DIR}/build/bin${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
                    $ENV_VERBOSE \
                    $ENV_PREDICTIVE_PREFETCH \
                    "$SERVER_BINARY" \
                        -m "$MODEL" \
                        -ngl "$NGL" \
                        -c "$CTX" \
                        --host "$HOST" \
                        --port "$LLAMA_PORT" \
                        --parallel "$PARALLEL" \
                        "${SLOT_CTX_ARGS[@]}" \
                        "${SSP_ARGS[@]}" \
                        "${CRAM_ARGS[@]}" \
                        "${CHAT_TEMPLATE_ARGS[@]}" \
                        "${MMPROJ_ARGS[@]}" \
                        --slots --metrics \
                        --no-mmap \
                        -t "$THREADS" $KV_CACHE_ARGS $FA_ARGS $SPEC_ARGS $TS_ARGS "${ALIAS_ARGS[@]}" $REASONING_ARGS $CKPT_ARGS $CACHE_ARGS &
                LLAMA_PID=$!
                echo "  llama-server running (PID $LLAMA_PID, internal port $LLAMA_PORT)"

                # Trap Ctrl+C to clean up llama-server
                trap "echo 'Shutting down...'; kill $LLAMA_PID 2>/dev/null; exit 0" INT TERM

                # Start shim in foreground on external port
                echo "  Starting VITRIOL memory shim on port $PORT..."
                env \
                    VITRIOL_MEMORY_MODE=on \
                    VITRIOL_KV_MODE="$KV_MODE" \
                    VITRIOL_KV_SCORE="$KV_SCORE" \
                    VITRIOL_KV_SCORE_EVERY="$KV_SCORE_EVERY" \
                    VITRIOL_FROZEN_PROMPT="$FROZEN_PROMPT" \
                    VITRIOL_SEMANTIC_MODE="$SEMANTIC_MODE" \
                    VITRIOL_KV_QUANT="$KV_QUANT" \
                    VITRIOL_LOOKUP="$LOOKUP" \
                    VITRIOL_ENGINE_MODE="$ENGINE_MODE" \
                    LLAMA_API_URL="http://${HOST}:${LLAMA_PORT}/v1/chat/completions" \
                    LLAMA_STATUS_URL="http://${HOST}:${LLAMA_PORT}/health" \
                    SHIM_PORT="$PORT" \
                    python3 "$SHIM_DIR/vitriol_shim.py"
            else
                exec env \
                    CUDA_VISIBLE_DEVICES="$CUDA_DEVICES" \
                    VITRIOL_MODE="$MODE" \
                    VITRIOL_LRU_MB="$LRU_MB" \
                    VITRIOL_KV_MODE="$KV_MODE" \
                    VITRIOL_KV_SCORE="$KV_SCORE" \
                    VITRIOL_KV_SCORE_EVERY="$KV_SCORE_EVERY" \
                    VITRIOL_FROZEN_PROMPT="$FROZEN_PROMPT" \
                    VITRIOL_SEMANTIC_MODE="$SEMANTIC_MODE" \
                    VITRIOL_KV_QUANT="$KV_QUANT" \
                    VITRIOL_LOOKUP="$LOOKUP" \
                    VITRIOL_ENGINE_MODE="$ENGINE_MODE" \
                    VITRIOL_DISK_OFFLOAD="$DISK_OFFLOAD" \
                    VITRIOL_EXPERT_COUNT="$EXPERT_COUNT" \
                    VITRIOL_OUTPUT_CACHE="$OUTPUT_CACHE" \
                    VITRIOL_PIN_FIRST_N_LAYERS="$PIN_FIRST_N_LAYERS" \
            VITRIOL_PRUNE_EXPERTS="$PRUNE_EXPERTS" \
            VITRIOL_EARLY_EXIT="${VITRIOL_EARLY_EXIT:-0}" \
            VITRIOL_EARLY_EXIT_THRESHOLD="${VITRIOL_EARLY_EXIT_THRESHOLD:-0.001}" \
            VITRIOL_EARLY_EXIT_MIN_LAYERS="${VITRIOL_EARLY_EXIT_MIN_LAYERS:-10}" \
                    VITRIOL_MODEL_PATH="$MODEL" \
                    LD_LIBRARY_PATH="${LLAMA_DIR}/build/bin${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
                    $ENV_VERBOSE \
                    $ENV_PREDICTIVE_PREFETCH \
                    "$SERVER_BINARY" \
                    -m "$MODEL" \
                    -ngl "$NGL" \
                    -c "$CTX" \
                    --host "$HOST" \
                    --port "$PORT" \
                    --parallel "$PARALLEL" \
                        "${SLOT_CTX_ARGS[@]}" \
                        "${SSP_ARGS[@]}" \
                        "${CRAM_ARGS[@]}" \
                    "${CHAT_TEMPLATE_ARGS[@]}" \
                        "${MMPROJ_ARGS[@]}" \
                    --slots --metrics \
                    --no-mmap \
                    -t "$THREADS" \
                    $KV_CACHE_ARGS $FA_ARGS $SPEC_ARGS $TS_ARGS "${ALIAS_ARGS[@]}" $REASONING_ARGS $CKPT_ARGS $CACHE_ARGS \
                    "$@"
            fi
        fi
        ;;

    stop)
        STOPPED=false

        # Under a systemd manager, raw kills lose: Restart=always resurrects
        # within 5 s. Explicit `systemctl --user stop` is sticky — no restart.
        # Exception: when invoked BY the unit itself (ExecStartPre), stopping
        # our own unit would deadlock — fall through to pidfile cleanup only.
        if [[ -z "${INVOCATION_ID:-}" ]] && systemctl --user cat vitriol-server.service >/dev/null 2>&1; then
            echo "→ Stopping via systemd (sticky, no auto-restart)..."
            systemctl --user stop vitriol-autosave.service 2>/dev/null || true
            systemctl --user stop vitriol-server.service || true
            STOPPED=true
            # still sweep strays from non-unit launches below if pidfiles remain
        fi

        # Stop shim (memory mode)
        SHIM_PID_FILE="${CONFIG_DIR}/shim.pid"
        if [[ -f "$SHIM_PID_FILE" ]]; then
            PID=$(cat "$SHIM_PID_FILE")
            echo "→ Stopping VITRIOL shim (PID $PID)..."
            kill "$PID" 2>/dev/null && echo "  ✓ Shim stopped" || echo "  (shim not running)"
            rm -f "$SHIM_PID_FILE"
            STOPPED=true
        fi

        # Stop llama-server (internal port in memory mode, or standard)
        LLAMA_PID_FILE="${CONFIG_DIR}/llama-server.pid"
        if [[ -f "$LLAMA_PID_FILE" ]]; then
            PID=$(cat "$LLAMA_PID_FILE")
            echo "→ Stopping llama-server (PID $PID)..."
            kill "$PID" 2>/dev/null && echo "  ✓ llama-server stopped" || echo "  (llama-server not running)"
            rm -f "$LLAMA_PID_FILE"
            STOPPED=true
        fi

        # Stop standard server
        PID_FILE="${CONFIG_DIR}/server.pid"
        if [[ -f "$PID_FILE" ]]; then
            PID=$(cat "$PID_FILE")
            echo "→ Stopping server (PID $PID)..."
            kill "$PID" 2>/dev/null && echo "  ✓ Stopped" || echo "  (not running)"
            rm -f "$PID_FILE"
            STOPPED=true
        fi

        if $STOPPED; then
            echo "  Waiting for graceful shutdown (DMA cleanup)..."
            sleep 2
        fi

        if ! $STOPPED; then
            echo "→ No PID files found. Searching for running processes..."
            pkill -f "llama-server.*Qwen3" 2>/dev/null && echo "  ✓ llama-server stopped" || true
            pkill -f "vitriol_shim" 2>/dev/null && echo "  ✓ VITRIOL shim stopped" || true
        fi
        ;;

    bench)
        shift
        # Run a quick benchmark using llama-bench
        CLI_MODEL=""
        CLI_CTX=""
        CLI_NGL=""
        CLI_LRU_MB=""
        CLI_VERBOSE=""
        CLI_PIN_LAYERS=""
        CLI_PRUNE_EXPERTS=""
        CLI_N=100
        DRY_RUN=false

        while [[ $# -gt 0 ]]; do
            case "$1" in
                -m) CLI_MODEL="$2"; shift 2 ;;
                -c) CLI_CTX="$2"; shift 2 ;;
                -ngl) CLI_NGL="$2"; shift 2 ;;
                -lru) CLI_LRU_MB="$2"; shift 2 ;;
                -n) CLI_N="$2"; shift 2 ;;
                --pin-layers) CLI_PIN_LAYERS="$2"; shift 2 ;;
                --prune-experts) CLI_PRUNE_EXPERTS="$2"; shift 2 ;;
                --verbose) CLI_VERBOSE="true"; shift ;;
                --dry-run) DRY_RUN=true; shift ;;
                -h|--help) usage; exit 0 ;;
                *) echo "Unknown: $1"; usage; exit 1 ;;
            esac
        done

        MODEL="${VITRIOL_MODEL:-${CLI_MODEL:-${CFG_MODEL}}}"
        MMPROJ="${VITRIOL_MMPROJ:-${CFG_MMPROJ:-}}"
        MMPROJ_ARGS=()
        [[ -n "${MMPROJ:-}" && -f "${MMPROJ:-}" ]] && MMPROJ_ARGS=(--mmproj "$MMPROJ")
        CTX="${CLI_CTX:-${CFG_CTX}}"
        NGL="${CLI_NGL:-${CFG_NGL}}"
        LRU_MB="${CLI_LRU_MB:-${CFG_LRU_MB}}"
        MODE="${VITRIOL_MODE:-${CFG_MODE}}"
        OUTPUT_CACHE="${CFG_OUTPUT_CACHE}"
        PREDICTIVE_PREFETCH="${CFG_PREDICTIVE_PREFETCH}"
        PIN_FIRST_N_LAYERS="${CLI_PIN_LAYERS:-${CFG_PIN_FIRST_N_LAYERS}}"
        PRUNE_EXPERTS="${CLI_PRUNE_EXPERTS:-${CFG_PRUNE_EXPERTS}}"
        VERBOSE="${CLI_VERBOSE:-${CFG_VERBOSE}}"
        DEVICE="${CFG_DEVICE}"

        N="${CLI_N}"

        if [[ "${PIN_FIRST_N_LAYERS:-0}" -gt 0 ]] && [[ "$OUTPUT_CACHE" == "on" ]]; then
            OUTPUT_CACHE="off"
        fi

        if [[ "$CFG_EXCLUDE_SECONDARY" == "true" ]]; then
            CUDA_DEVICES="${DEVICE}"
        else
            CUDA_DEVICES="0,1"
        fi

        BENCH_BINARY="${LLAMA_DIR}/build/bin/llama-bench"

        if [[ ! -f "$MODEL" ]]; then
            echo "ERROR: model not found: $MODEL"; exit 1
        fi
        if [[ ! -x "$BENCH_BINARY" ]]; then
            echo "ERROR: llama-bench not found at $BENCH_BINARY"; exit 1
        fi

        MODEL_SIZE=$(stat --format=%s "$MODEL" 2>/dev/null | numfmt --to=iec || echo "?")

        echo "═══ VITRIOL Bench ═══"
        echo "  Model:    $(basename "$MODEL") ($MODEL_SIZE)"
        echo "  Gen:      $N tokens"
        echo "  GPU:      Device $DEVICE"
        echo "  Mode:     $MODE"
        [[ "$OUTPUT_CACHE" == "on" ]] && echo "  Cache:    output cache"
        [[ "$PREDICTIVE_PREFETCH" == "on" ]] && echo "  Prefetch: predictive"
        [[ "${PIN_FIRST_N_LAYERS:-0}" -gt 0 ]] && echo "  Pin:      $PIN_FIRST_N_LAYERS layers"
        [[ "${PRUNE_EXPERTS:-0}" -gt 0 ]] && echo "  Prune:    $PRUNE_EXPERTS experts"
        [[ "${NGL}" -gt 0 ]] && echo "  NGL:      $NGL"
        echo "══════════════════════"
        echo ""

        if $DRY_RUN; then
            exit 0
        fi

        ENV_VERBOSE=""
        [[ "$VERBOSE" == "true" ]] && ENV_VERBOSE="VITRIOL_VERBOSE=1"
        ENV_PREDICTIVE_PREFETCH=""
        [[ "$PREDICTIVE_PREFETCH" == "on" ]] && ENV_PREDICTIVE_PREFETCH="VITRIOL_PREDICTIVE_PREFETCH=1"

        echo "NOTE: Run 'vitriol setup' first for CAP_IPC_LOCK on llama-bench"
        echo ""

        env \
            CUDA_VISIBLE_DEVICES="$CUDA_DEVICES" \
            VITRIOL_MODE="$MODE" \
            VITRIOL_LRU_MB="$LRU_MB" \
            VITRIOL_OUTPUT_CACHE="$OUTPUT_CACHE" \
            VITRIOL_PIN_FIRST_N_LAYERS="$PIN_FIRST_N_LAYERS" \
            VITRIOL_PRUNE_EXPERTS="$PRUNE_EXPERTS" \
            VITRIOL_EARLY_EXIT="${VITRIOL_EARLY_EXIT:-0}" \
            VITRIOL_EARLY_EXIT_THRESHOLD="${VITRIOL_EARLY_EXIT_THRESHOLD:-0.001}" \
            VITRIOL_EARLY_EXIT_MIN_LAYERS="${VITRIOL_EARLY_EXIT_MIN_LAYERS:-10}" \
            VITRIOL_PREDICTIVE_PREFETCH="$PREDICTIVE_PREFETCH" \
            LD_LIBRARY_PATH="${LLAMA_DIR}/build/bin${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
            $ENV_VERBOSE \
            "$BENCH_BINARY" \
            -m "$MODEL" \
            -ngl "$NGL" \
            -c "${CTX}" \
            -p 64 \
            -n "$N" \
            -t 4 2>&1
        ;;

    tui)
        # Terminal ops dashboard (Ratatui). Replaces the old Textual TUI
        # (libvitriol/vitriol-tui.py, never built out). Builds on first use;
        # VITRIOL_REPO is exported so repo detection works from any cwd.
        TUI_BIN="${PROJECT_DIR}/vitriol-tui/target/release/vitriol-tui"
        if [[ ! -x "$TUI_BIN" ]]; then
            echo "[vitriol] building vitriol-tui (first run)…"
            (cd "${PROJECT_DIR}/vitriol-tui" && cargo build --release) || exit 1
        fi
        exec env VITRIOL_REPO="$PROJECT_DIR" "$TUI_BIN"
        ;;

    officina)
        # VITRIOL Officina (2026-08-31, owner-approved bundling): the coding
        # workshop coupled to this engine. Single-source rule: the scaffold
        # code lives in its own repo; this launcher only resolves + execs it,
        # and honestly reports engine state first (fingerprint discipline).
        # 2026-08-31 bugfix: shift FIRST — without it the literal word
        # "officina" fell through into "$@" and pi read it as a first prompt.
        shift
        OFFICINA_DIR="${OFFICINA_DIR:-${PROJECT_DIR}/officina}"
        OFFICINA_ENTRY="${OFFICINA_DIR}/officina.mjs"
        if [[ ! -f "$OFFICINA_ENTRY" ]]; then
            echo "[vitriol] officina not found at ${OFFICINA_ENTRY}" >&2
            echo "[vitriol] install it, or set OFFICINA_DIR to its directory." >&2
            exit 1
        fi
        if ! command -v node >/dev/null 2>&1; then
            NODE_BIN="$(find "${HOME}/.local/share/fnm/node-versions" -path '*/installation/bin/node' 2>/dev/null | sort -V | tail -1)"
            [[ -z "$NODE_BIN" && -x /usr/bin/node ]] && NODE_BIN=/usr/bin/node
            if [[ -z "$NODE_BIN" ]]; then
                echo "[vitriol] officina needs node (fnm or system) — not found." >&2
                exit 1
            fi
            PATH="$(dirname "$NODE_BIN"):$PATH"
        fi
        # Engine truth before the workshop opens (never guess, Rule 4/5):
        if ! curl -sf "http://127.0.0.1:8279/health" >/dev/null 2>&1; then
            echo "[vitriol] engine is DOWN on 127.0.0.1:8279 — 'vitriol serve' first (or let the workshop run engine-less)." >&2
        fi
        # cwd passthrough: the workshop opens for THIS directory (session-local
        # project context), which is the whole point of the bundled flow.
        exec node "$OFFICINA_ENTRY" "$@"
        ;;

    install)
        # Symlink `vitriol` (and vitriol-tui) onto PATH via scripts/install.sh.
        shift
        exec bash "${PROJECT_DIR}/scripts/install.sh" "$@"
        ;;

    uninstall)
        # Remove the install.sh symlinks.
        exec bash "${PROJECT_DIR}/scripts/install.sh" --uninstall
        ;;

    services)
        # Install systemd user units from the repo (canonical copies live in
        # systemd/user/). `vitriol services uninstall` removes them again.
        shift
        ACTION="install"
        [[ "${1:-}" == "uninstall" ]] && ACTION="uninstall"
        UNIT_DIR="${HOME}/.config/systemd/user"
        SRC_DIR="${PROJECT_DIR}/systemd/user"
        if [[ "$ACTION" == "install" ]]; then
            mkdir -p "$UNIT_DIR"
            # dependency order: vector store → recall sidecar → server
            for u in mongod-vitriol.service vitriol-rag.service \
                     vitriol-autosave.service vitriol-server.service; do
                [[ -f "${SRC_DIR}/${u}" ]] || continue
                cp "${SRC_DIR}/${u}" "${UNIT_DIR}/${u}"
                echo "✓ installed ${u}"
            done
            systemctl --user daemon-reload
            echo ""
            echo "Units installed. Enable + start:"
            echo "  systemctl --user enable --now vitriol-server.service"
            echo "  (the autosave sidecar follows via Wants=/PartOf=)"
        else
            for u in vitriol-autosave.service vitriol-server.service; do
                systemctl --user stop "$u" 2>/dev/null || true
                rm -f "${UNIT_DIR}/${u}" && echo "✓ removed ${u}"
            done
            systemctl --user daemon-reload
        fi
        ;;

    pymander)
        # 2026-09-01 DEPRECATED (deprecation audit): Officina memory
        # (~/.vitriol/officina/memory + per-project .officina/MEMORY.md)
        # replaced the pymander recall path for the workshop. The Rust
        # binary below still works for direct store access until removal.
        echo "[vitriol] pymander is deprecated - Officina memory replaced it." >&2
        echo "[vitriol] direct store access still available this release:" >&2
        shift
        # 2026-08-07: Pymander CLI is now the Rust binary (libhermes).
        if [ -x "${PROJECT_DIR}/libhermes/target/release/pymander" ]; then
            PYMAN=("${PROJECT_DIR}/libhermes/target/release/pymander")
        else
            PYMAN=("${PROJECT_DIR}/libhermes/target/debug/pymander")
        fi
        if [[ $# -eq 0 ]]; then
            "${PYMAN[@]}" --help
            exit 0
        fi
        "${PYMAN[@]}" "$@"
        ;;

    config)
        shift
        case "${1:-}" in
            show)  config_show ;;
            init)  config_init ;;
            reset) config_reset ;;
            edit)  ${EDITOR:-vim} "$CONFIG_FILE" ;;
            set)   shift; config_set "$1" "$2" ;;
            save)  shift; profiles_save "$1" "$2" ;;
            load)  shift; profiles_load "$1" ;;
            list)  profiles_list ;;
            delete) shift; profiles_delete "$1" ;;
            diff)  shift; profiles_diff "$1" ;;
            bless)   config_bless ;;
            blessed) config_blessed ;;
            unbless) config_unbless ;;
            *)     tui_main_menu ;;
        esac
        ;;

    calibrate)
        shift
        cal_model="$CFG_MODEL"
        cal_profile="calibrated"
        cal_quick=false

        while [[ $# -gt 0 ]]; do
            case "$1" in
                --model|-m) cal_model="$2"; shift 2 ;;
                --profile)  cal_profile="$2"; shift 2 ;;
                --quick|-q) cal_quick=true; shift ;;
                *) echo "Unknown: $1"; exit 1 ;;
            esac
        done

        if $cal_quick; then
            calibrate_quick "$cal_model" "$cal_profile"
        else
            calibrate_quick "$cal_model" "$cal_profile"
            echo ""
            echo "  (Full benchmark sweep coming in a future release —"
            echo "   for now, --quick provides the VRAM-based estimate.)"
        fi
        ;;

    setup)
        BUILD_DIR="${LLAMA_DIR}/build/bin"
        # 2026-08-06: fix RUNPATH FIRST. patchelf rewrites the ELF and clears file
        # capabilities, so setcap-after-patchelf would be wiped. Order: rpath, then caps.
        fix_rpath "$BUILD_DIR"

        if [[ -x "$BINARY" ]]; then
            setup_caps "$BINARY"
        fi
        if [[ -x "$SERVER_BINARY" ]]; then
            setup_caps "$SERVER_BINARY"
        fi
        # Also set caps on llama-bench if it exists
        BENCH_BINARY="${BUILD_DIR}/llama-bench"
        if [[ -x "$BENCH_BINARY" ]]; then
            setup_caps "$BENCH_BINARY"
        fi
        ;;

    validate|lanes|budget|ledger-ingest|perms-sync|status)
        # 2026-09-01 (fold-in): the tris front door folded into vitriol.
        # These subcommands exec the officina CLI (single source:
        # officina/cli). `vitriol officina` remains the workshop entry.
        shift   # drop the subcommand word; "$@" is the CLI's own args
        TRIS_PY="${OFFICINA_CLI_PY:-${HOME}/venvs/tris/bin/python}"
        [[ -x "$TRIS_PY" ]] || TRIS_PY=python3
        exec "$TRIS_PY" "${PROJECT_DIR}/officina/cli/bin/trismegistus" "$CMD" "$@"
        ;;

    help|--help|-h)
        usage
        ;;

    *)
        usage
        exit 1
        ;;
esac
