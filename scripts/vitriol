#!/bin/bash
# VITRIOL — MoE Expert Offloading via PCIe DMA
#
# Usage:
#   vitriol run              launch inference
#   vitriol config           interactive config TUI
#   vitriol setup            set CAP_IPC_LOCK capability
#   vitriol help             this message

set -euo pipefail

# ── paths ────────────────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
LLAMA_DIR="${PROJECT_DIR}/llama.cpp"
BINARY="${LLAMA_DIR}/build/bin/llama-cli"
SERVER_BINARY="${LLAMA_DIR}/build/bin/llama-server"

# Sparse-KV guard (context lifecycle 2026-09-03): a config that requests
# kv.mode=sparse against an engine built WITHOUT the lull KV code would
# silently no-op — the KV cache then never ejects (the Aug-31 regression:
# consolidation dropped lull-kv from main, the rebuild shipped without it,
# and nothing complained for days). Probe the binary AND its libllama for
# the sparse entry point; refuse the launch if absent. grep -a works on
# binaries — no strings(1) dependency.
kv_sparse_guard() {
    [ "$KV_MODE" = "sparse" ] || return 0
    local found=0 f
    for f in "$SERVER_BINARY" "$LLAMA_DIR"/build/bin/libllama.so*; do
        [ -f "$f" ] || continue
        if grep -qa "VITRIOL_KV_MODE" "$f" 2>/dev/null; then found=1; break; fi
    done
    if [ "$found" = 0 ]; then
        echo "VITRIOL: REFUSING launch — config requests kv.mode=sparse but the engine has no sparse-KV code (VITRIOL_KV_MODE absent from $SERVER_BINARY and its libllama)." >&2
        echo "         Rebuild an engine with lull-kv (VITRIOL-lull worktree) or set kv.mode = standard." >&2
        exit 1
    fi
}

# Protected-serve guard (context lifecycle 2026-09-03): bare 'serve' from
# an oom-elevated shell scope spawns a kill-first server (the Aug-31-era
# OOM deaths — unprotected instances die before the unit's). When the
# managing unit exists AND is active, delegate to it. The unit's own
# ExecStart runs this same command and is exempt via its cgroup.
serve_unit_guard() {
    local unit="$HOME/.config/systemd/user/vitriol-server.service"
    [ -f "$unit" ] || return 0
    # --dry-run prints config and launches nothing — always exempt.
    $DRY_RUN && return 0
    grep -qa "vitriol-server.service" /proc/self/cgroup 2>/dev/null && return 0
    if systemctl --user is-active --quiet vitriol-server.service 2>/dev/null; then
        echo "VITRIOL: REFUSING bare serve — vitriol-server.service is already managing the engine." >&2
        echo "         Use: systemctl --user restart vitriol-server.service" >&2
        echo "         (the unit is protected: oom-shield + Restart=always; a bare serve would be oom-elevated and die first)" >&2
        exit 1
    fi
    echo "VITRIOL: note — unit file present but service inactive; running UNPROTECTED (no oom-shield lifecycle)." >&2
    echo "         Consider: systemctl --user enable --now vitriol-server.service" >&2
}

# ── Launch Fingerprint Journal (2026-09-03 doctrine) ──────────────
# Every launch appends 'LAUNCH <iso> <fingerprint>' to
# ~/.vitriol/fingerprint.log and diffs against the previous launch AND
# the blessed operating point. Deltas print VITRIOL-FLAG-DELTA and
# NEVER block a launch. --dry-run reviews without writing.
# Born from the MTP flag-drift incident (2026-08-31 -> 09-03, +40%
# decode lost for weeks): see .opencode/plans/mtp-flag-drift-postmortem-2026-09-03.md
FP_LOG="${FP_LOG:-$HOME/.vitriol/fingerprint.log}"
FP_LAST="${FP_LAST:-$HOME/.vitriol/fingerprint.last}"
FP_BLESSED="${FP_BLESSED:-$HOME/.vitriol/fingerprint.blessed}"

_fp_delta() {
    # Per-field diff of two fingerprint lines: 'key: old -> new'.
    local oldfp="$1" newfp="$2"
    local -A oldf newf
    local kv k
    for kv in $oldfp; do oldf[${kv%%=*}]=${kv#*=}; done
    for kv in $newfp; do newf[${kv%%=*}]=${kv#*=}; done
    local -a seen=()
    for kv in $newfp; do
        k=${kv%%=*}
        if [[ " ${seen[*]-} " == *" $k "* ]]; then continue; fi
        seen+=("$k")
        local ov="${oldf[$k]:-}" nv="${newf[$k]:-}"
        if [[ -z "$ov" && -n "$nv" ]]; then echo "  $k: <new> -> $nv"
        elif [[ "$ov" != "$nv" ]]; then echo "  $k: $ov -> $nv"
        fi
    done
    # NOTE: if-block, not `[[ ]] &&` — a short-circuited loop body under
    # set -e makes the for-loop return 1 and kills the script silently.
    for k in "${!oldf[@]}"; do
        if [[ -z "${newf[$k]:-}" ]]; then echo "  $k: ${oldf[$k]} -> <dropped>"; fi
    done
}

compute_fingerprint() {
    # Canonical fingerprint body — the ONLY printf for it. Args:
    # model-basename ts ctx kv_k kv_v ub mode engine ckpt lru sparse
    # score pool_reset spec_type spec_draft_n_max
    printf 'VITRIOL-FINGERPRINT model=%s ts=%s c=%s kv=%s/%s fa=on ub=%s mode=%s engine=%s ckpt=%s lru=%s sparse=%s score=%s pool_reset=%s spec=%s:%s' "$@"
}

config_fingerprint() {
    # Fingerprint from the CONFIG FILE ALONE (no CLI, no env). Used by
    # 'config bless'. Launches with CLI/env overrides will legitimately
    # differ — the blessed-delta makes that visible, not an error.
    parse_config
    local fp
    fp=$(compute_fingerprint \
        "$(basename "${CFG_MODEL:-?}")" "${CFG_TENSOR_SPLIT:-none}" "${CFG_CTX:-?}" \
        "${CFG_KV_QUANT}" "${CFG_KV_QUANT_V}" "${CFG_UBATCH:-256}" \
        "${CFG_MODE}" "${CFG_ENGINE_MODE}" "${CFG_CKPT_EVERY:-2048}" "${CFG_LRU_MB:-0}" \
        "${CFG_KV_MODE}" "${CFG_KV_SCORE:-off}" "0" \
        "${CFG_SPEC_TYPE:-none}" "${CFG_SPEC_DRAFT_N_MAX:-0}")
    # Mirror the serve path's conditional fields so blessed-vs-launch
    # diffs stay clean (only REAL differences show up).
    [[ -n "${CFG_SLOT_CONTEXT:-}" ]] && fp="$fp slots=$CFG_SLOT_CONTEXT"
    [[ -n "${CFG_SLOT_SAVE_PATH:-}" ]] && fp="$fp ssp=1"
    [[ -n "${CFG_CACHE_RAM:-}" ]] && fp="$fp cram=$CFG_CACHE_RAM"
    [[ -n "${CFG_CHAT_TEMPLATE:-}" ]] && fp="$fp ct=$(basename "$CFG_CHAT_TEMPLATE")"
    [[ -n "${CFG_MMPROJ:-}" && -f "${CFG_MMPROJ:-}" ]] && fp="$fp vis=on"
    [[ "${CFG_CACHE_IDLE_SLOTS:-on}" == "off" ]] && fp="$fp cis=0"
    printf '%s' "$fp"
}

config_journal() {
    # Mutation record for config commands: CONFIG-EDIT <iso> <detail>.
    printf 'CONFIG-EDIT %s %s\n' "$(date -Is)" "$1" >> "$FP_LOG"
}

fingerprint_journal() {
    local prev="" bfp="" bdate=""
    [[ -f "$FP_LAST" ]] && prev=$(head -1 "$FP_LAST" 2>/dev/null)
    if [[ "${DRY_RUN:-false}" == "true" ]]; then
        if [[ -n "$prev" && "$prev" != "$FINGERPRINT" ]]; then
            echo "VITRIOL-FLAG-DELTA (projected — dry-run writes nothing):"
            _fp_delta "$prev" "$FINGERPRINT"
        fi
    else
        if [[ -n "$prev" && "$prev" != "$FINGERPRINT" ]]; then
            echo "VITRIOL-FLAG-DELTA: launch flags changed since previous launch:"
            _fp_delta "$prev" "$FINGERPRINT"
        fi
        printf 'LAUNCH %s %s\n' "$(date -Is)" "$FINGERPRINT" >> "$FP_LOG"
        printf '%s' "$FINGERPRINT" > "$FP_LAST"
    fi
    if [[ -f "$FP_BLESSED" ]]; then
        bfp=$(head -1 "$FP_BLESSED" 2>/dev/null)
        bdate=$(sed -n 2p "$FP_BLESSED" 2>/dev/null)
        if [[ -n "$bfp" && "$bfp" != "$FINGERPRINT" ]]; then
            echo "VITRIOL-FLAG-DELTA: differs from BLESSED operating point (blessed ${bdate:-?}):"
            _fp_delta "$bfp" "$FINGERPRINT"
        fi
    fi
}

config_bless() {
    mkdir -p "$(dirname "$FP_BLESSED")"
    local fp
    fp=$(config_fingerprint)
    printf '%s\n%s\n' "$fp" "$(date -Is)" > "$FP_BLESSED"
    echo "✓ Blessed operating point pinned ($(date -Is)):"
    echo "  $fp"
}

config_unbless() {
    if [[ -f "$FP_BLESSED" ]]; then
        rm -f "$FP_BLESSED"
        echo "✓ Blessed operating point cleared"
    else
        echo "No blessed operating point pinned (vitriol config bless)"
    fi
}

config_blessed() {
    if [[ ! -f "$FP_BLESSED" ]]; then
        echo "No blessed operating point pinned (vitriol config bless)"
        return 1
    fi
    local bfp bdate cfp
    bfp=$(head -1 "$FP_BLESSED")
    bdate=$(sed -n 2p "$FP_BLESSED")
    echo "Blessed operating point (pinned $bdate):"
    echo "  $bfp"
    cfp=$(config_fingerprint)
    if [[ "$bfp" == "$cfp" ]]; then
        echo "  config matches blessed ✓"
    else
        echo "  config DIFFERS from blessed:"
        _fp_delta "$bfp" "$cfp"
    fi
}
